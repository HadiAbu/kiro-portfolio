{
  "version": "v1",
  "hooks": [
    {
      "name": "ESlint",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "npx eslint --fix src"
      },
      "description": "run eslint to fix sytax errors",
      "matcher": "\\.(ts|tsx)$",
      "enabled": true
    }
  ]
}
